{
  "name": "onebase-js",
  "version": "0.1.0",
  "description": "Isomorphic JavaScript/TypeScript client for an onebase backend (Postgres + PostgREST + auth + storage + realtime + edge functions).",
  "type": "module",
  "license": "MIT",
  "author": "OneCode ApS",
  "homepage": "https://github.com/OneCodeApS/onebase-js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OneCodeApS/onebase-js.git"
  },
  "bugs": {
    "url": "https://github.com/OneCodeApS/onebase-js/issues"
  },
  "keywords": [
    "onebase",
    "onecode",
    "postgrest",
    "postgres",
    "supabase",
    "backend",
    "sdk"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@supabase/postgrest-js": "^2.106.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
